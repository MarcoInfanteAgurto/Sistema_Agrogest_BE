# =============================================
# AGROGEST - Variables de Entorno (EJEMPLO)
# =============================================
# Copia este archivo como ".env" y rellena con tus propias credenciales.
# NUNCA subas el archivo ".env" al repositorio.
# =============================================

# --- Base de datos (PostgreSQL) ---
DB_NAME=agrogest_db
DB_USER=postgres
DB_PASSWORD=postgres123
DB_PORT=5432
DB_HOST=localhost

# URL completa (automática si usas docker-compose)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agrogest_db

# --- Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Docker Hub Credentials (para pipeline GitHub Actions) ---
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

# --- pgAdmin ---
PGADMIN_EMAIL=admin@agrogest.local
PGADMIN_PASSWORD=admin123

# --- Application ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8083
JAVA_OPTS=-Xms512m -Xmx1024m
