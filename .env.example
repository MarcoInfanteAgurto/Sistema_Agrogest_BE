# =============================================
# AGROGEST - Variables de Entorno (EJEMPLO)
# =============================================
# Copia este archivo como ".env" y rellena con tus propias credenciales.
# NUNCA subas el archivo ".env" al repositorio.
# =============================================

# --- Base de datos (NeonDB PostgreSQL) ---
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# Host de NeonDB (pooler)
DB_HOST=your-neondb-host.neon.tech

# La URL se construye automáticamente en start-backend.ps1
# Si ejecutas un servicio individualmente (mvn spring-boot:run), define aquí su URL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>/<db_name>?sslmode=require&channel_binding=require

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- OpenWeatherMap (weather-service) ---
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
